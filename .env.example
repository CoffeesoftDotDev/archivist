# Copy to `.env` and adjust. Unset or empty = built-in default.
# Booleans: true/false, 1/0, yes/no, on/off

# Host folder mounted into the container at /data (used by docker-compose.yml)
HOST_PARENT_FOLDER=./photos

# Runs only show what would change until this is true
# ARCHIVIST_APPLY=false

# ARCHIVIST_LEAVE_ZIP=false
# ARCHIVIST_LEAVE_APPLEDOUBLE=false
# ARCHIVIST_LEAVE_EADIR=false
# ARCHIVIST_LEAVE_DS_STORE=false
# ARCHIVIST_LEAVE_THUMBS_DB=false
# ARCHIVIST_LEAVE_DESKTOP_INI=false
# ARCHIVIST_MAX_SIZE=2048
# ARCHIVIST_FORCE_READONLY_DELETION=false
# ARCHIVIST_SEND_TO_BIN=false
# ARCHIVIST_LOG_FILE=            # default /data/report.log; a path like /data/logs/run.log, or false to disable
